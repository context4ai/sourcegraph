{
  "name": "sourcegraph-service-development",
  "private": true,
  "scripts": {
    "format": "gofmt -w cmd internal",
    "check": "make check && bun run check:web",
    "build": "bash build.sh local",
    "verify": "bun run check && bun run build",
    "build:release": "bash build.sh release",
    "build:web": "bun scripts/build-web.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "check:web": "node scripts/check-web.mjs",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "version": "0.1.0",
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "packageManager": "bun@1.3.9"
}
